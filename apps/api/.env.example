# ─────────────────────────────────────────────────────────────────────
# Phoenix Vapers API — environment (spec §16.9)
#
# Copy to `.env` for local development. Secrets NEVER live in the repo:
# real credentials come from the secrets manager in deployed environments.
# Every variable here is validated at boot (src/common/config/env.validation.ts);
# the API refuses to start if configuration is missing or malformed.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Port the API listens on (storefront: 3000, admin: 3001, api: 4000)
API_PORT=4000

# Redis — cache, sessions, rate-limits, BullMQ job queues
REDIS_URL=redis://127.0.0.1:6379

# MongoDB — portable local single-node replica set (pnpm mongo:start)
MONGODB_URI=mongodb://127.0.0.1:27017/phoenix?directConnection=true

# Browser origin allowed by CORS (admin console is served here under /admin)
WEB_ORIGIN=http://localhost:3000

# Operators (staff) sign in through the storefront /login with real accounts.
# Bootstrap the first platform admin:
#   pnpm create-admin -- --email you@x.dev --password '<>=10 chars>' --role platform_admin

# ── Customer auth (Phase 2, spec §16.4) ─────────────────────────────

# Signs customer JWT access tokens — >= 32 chars of randomness; never commit real values.
JWT_SECRET=dev-only-change-me-use-32-chars-minimum-ok
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# ── Age verification (Phase 2, spec §4.2) [COMPLIANCE] ─────────────

# Provider adapter: mock locally; real provider adapter drops in later.
AV_PROVIDER=mock
# AV_FAULT_MODE=outage
AV_PASS_TTL_DAYS=365
