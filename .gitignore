coverage/
playwright-report/

# Local dev services (portable MongoDB binaries + data — never committed)
.local/

# Redis dumps — runtime data (sessions/carts), never committed
*.rdb

# Claude Code — personal/local settings only (shared settings.json may commit)
.claude/settings.local.json
